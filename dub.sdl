name "ddcurl"
description "High-level libcurl integration"
authors "dd86k <dd@dax.moe>"
copyright "Copyright © 2025, dd86k <dd@dax.moe>"
license "ISC"

dependency "ddlogger" repository="git+https://github.com/dd86k/ddlogger.git" version="dcab663a80d496c1d3c7fee4c406ed7f763e5fdb"

configuration "dynamic" {
    dependency "ddloader" repository="git+https://github.com/dd86k/ddloader.git" version="9c3d572db435df9614628bb7665875044ae03261"
    versions "DynamicBinding"
}

configuration "static" {
    versions "StaticBinding"
    libs "libcurl-arm64" platform="windows-aarch64"
    libs "libcurl-x64" platform="windows-x86_64"
    libs "curl" platform="posix"
}

subPackage "client"
subPackage "tests"
